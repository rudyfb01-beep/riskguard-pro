# ==============================================================================
# VARIABLES DE ENTORNO - CUSTODIA RISK MANAGEMENT
# Copia este archivo como .env para despliegue local
# ==============================================================================

# 1. INTELIGENCIA ARTIFICIAL GENERATIVA (OPCIONAL)
# Clave API para análisis de causa raíz y recomendaciones del Comité de Riesgos
GEMINI_API_KEY=""

# 2. URL BASE DE LA APLICACIÓN
APP_URL="http://localhost:3000"
PORT=3000

# 3. CONEXIÓN A BASE DE DATOS POSTGRESQL (LOCAL / DOCKER)
# Opción A: Cadena de conexión URI completa (Recomendada)
DATABASE_URL="postgres://postgres:postgrespassword@localhost:5432/custodia_risk"

# Opción B: Parámetros individuales de PostgreSQL
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="custodia_risk"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgrespassword"

# 4. DATOS INICIALES
# true: en una base vacía carga datos de ejemplo FICTICIOS (para evaluar la app).
# false (producción): solo cargos de gobierno cooperativo, plazos regulatorios y
# un usuario administrador (correo configurable con ADMIN_EMAIL).
SEED_DEMO_DATA=false
ADMIN_EMAIL="admin@cooperativa.cl"

# 5. SSL HACIA POSTGRESQL (bases administradas en la nube)
DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
