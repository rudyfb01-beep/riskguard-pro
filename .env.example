# ==============================================================================
# RiskGuard Pro — configuración de producción
# Copie este archivo como .env (cp .env.example .env), complete los valores y
# guárdelo con permisos restringidos (chmod 600 .env). No lo suba al repositorio.
# Si falta algo obligatorio, la aplicación no arranca e indica qué corregir.
# ==============================================================================

# --- Dirección pública (OBLIGATORIO) ------------------------------------------
# Con HTTPS. Se usa en los enlaces de los correos, el retorno de Google y las cookies.
APP_URL=https://grc.cooperativa.cl
# Solo con el proxy incluido (docker compose --profile https): nombre del servidor y certificado.
APP_DOMAIN=grc.cooperativa.cl
# internal = CA interna de Caddy (red interna) · un correo = certificado de Let's Encrypt (dominio público)
TLS_MODE=internal

# --- Base de datos PostgreSQL (OBLIGATORIO) -----------------------------------
POSTGRES_DB=riskguard
POSTGRES_USER=riskguard
# Contraseña larga y propia (p. ej. openssl rand -base64 24). No use "postgres".
POSTGRES_PASSWORD=

# --- Seguridad (OBLIGATORIO) ----------------------------------------------------
# Clave para firmar los códigos de acceso: al menos 32 caracteres (openssl rand -hex 32).
AUTH_SECRET=

# --- Administrador inicial (OBLIGATORIO en la primera instalación) ------------
# Correo de la persona que administrará cargos y usuarios. Solo se usa en una base nueva.
ADMIN_EMAIL=

# --- Aplicación autenticadora (opcional) ----------------------------------------
# true: cada persona entra con su correo y el número de Google Authenticator (o Microsoft
# Authenticator). No necesita correo. El administrador activa el autenticador de cada persona en
# Puestos & Permisos; el primero, desde el servidor:
#   docker compose exec app node dist/app/server/server.mjs autenticador <correo>
# Los secretos se cifran con AUTH_SECRET: si lo cambia, hay que volver a activar los autenticadores.
AUTH_TOTP=false

# --- Correo (OBLIGATORIO salvo ingreso con autenticador o solo con Google) -----
# Envía el código de acceso y los avisos. Google Workspace: ver LOCAL_SETUP.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false            # true para el puerto 465 (TLS directo)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RiskGuard Pro <riskguard@cooperativa.cl>
SMTP_HELO_NAME=              # p. ej. cooperativa.cl (lo exige el relay de Google)

# --- Ingreso con Google (opcional) ---------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAINS=      # p. ej. cooperativa.cl (recomendado)
# true (código y Google) · false (solo Google) · admins (código solo de emergencia para administradores)
AUTH_EMAIL_CODE=true

# --- Sesión ---------------------------------------------------------------------
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=10

# --- Operación ------------------------------------------------------------------
TZ=America/Santiago
NOTIFY_INTERVAL_MINUTES=15
# Descarga diaria de la UF desde mindicador.cl (false si el servidor no tiene salida a internet).
UF_AUTO_SYNC=true
EVIDENCE_MAX_MB=15
# Respaldos automáticos (pg_dump) en el volumen "backups": cada N horas, se guardan los últimos K.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
RATE_LIMIT_PER_MINUTE=600
# Puerto local de la aplicación (detrás del proxy). APP_BIND=0.0.0.0 solo si el proxy está en otro equipo.
APP_BIND=127.0.0.1
APP_PORT=3000
# Versión que se informa en /api/health (p. ej. la etiqueta de la entrega).
APP_VERSION=

# --- Alertas de KRI por SMS (opcional) -----------------------------------------
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=

# --- Análisis con IA (opcional) ------------------------------------------------
# Envía a Google (Gemini) la descripción de incidentes y métricas del tablero. Evalúe la
# política de datos de la cooperativa antes de activarlo.
GEMINI_API_KEY=
