# ==============================================================================
# VARIABLES DE ENTORNO - CUSTODIA RISK MANAGEMENT
# Copia este archivo como .env para despliegue local
# ==============================================================================

# 1. INTELIGENCIA ARTIFICIAL GENERATIVA (OPCIONAL)
# Clave API para análisis de causa raíz y recomendaciones del Comité de Riesgos
GEMINI_API_KEY=""

# 2. URL BASE DE LA APLICACIÓN
APP_URL="http://localhost:3000"
PORT=3000

# 3. BASE DE DATOS
# DB_CLIENT: postgres | sqlite | none (modo demostración). Sin definir: PostgreSQL si hay
# DATABASE_URL o POSTGRES_HOST; si no, SQLite en SQLITE_PATH (por defecto ./data/riskguard.db).
# DB_CLIENT=sqlite
# SQLITE_PATH="./data/riskguard.db"

# PostgreSQL · Opción A: Cadena de conexión URI completa (Recomendada)
DATABASE_URL="postgres://postgres:postgrespassword@localhost:5432/custodia_risk"

# Opción B: Parámetros individuales de PostgreSQL
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="custodia_risk"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgrespassword"

# 4. DATOS INICIALES
# true: en una base vacía carga datos de ejemplo FICTICIOS (para evaluar la app).
# false (producción): solo cargos de gobierno cooperativo, plazos regulatorios y
# un usuario administrador (correo configurable con ADMIN_EMAIL).
SEED_DEMO_DATA=false
ADMIN_EMAIL="admin@cooperativa.cl"

# 5. SSL HACIA POSTGRESQL (bases administradas en la nube)
DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# 6. INICIO DE SESIÓN CON CÓDIGO POR CORREO
# Google Workspace: relay smtp-relay.gmail.com (autenticado por IP) o smtp.gmail.com con
# contraseña de aplicación. Detalles en LOCAL_SETUP.md.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false            # true para el puerto 465 (TLS directo)
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="RiskGuard Pro <riskguard@cooperativa.cl>"
SMTP_HELO_NAME=""            # p. ej. cooperativa.cl (requerido por el relay de Google)
# Solo para evaluar sin SMTP: escribe los códigos en el log del servidor. Nunca en producción.
AUTH_DEV_LOG_CODES=false
# Clave para firmar los códigos (cadena aleatoria larga). Recomendada con varias instancias.
AUTH_SECRET=""
# Sesión: minutos de inactividad y duración máxima en horas.
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=10
# Detrás de un proxy HTTPS: TRUST_PROXY=1 (o COOKIE_SECURE=true) para marcar la cookie como segura.
TRUST_PROXY=""
COOKIE_SECURE=""

# 7. AVISOS Y CORREO (usan el mismo SMTP)
# APP_URL (sección 2) se usa en los enlaces de los correos. TZ define la hora del resumen diario.
TZ="America/Santiago"
# Cada cuántos minutos se revisan plazos y se envían correos (0 lo desactiva).
NOTIFY_INTERVAL_MINUTES=15
# Solo para evaluar sin SMTP: escribe en el log los correos de aviso.
NOTIFY_DEV_LOG=false
