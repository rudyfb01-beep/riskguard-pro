# =============================================================================
# RiskGuard Pro · configuración de la instalación local (SQLite)
# Edita este archivo con el Bloc de notas y vuelve a iniciar la aplicación.
# =============================================================================

# Puerto: la aplicación queda en http://localhost:3000
PORT=3000

# Base de datos SQLite (un solo archivo). Respáldalo con respaldar.bat / respaldar.sh.
DB_CLIENT=sqlite
SQLITE_PATH=./data/riskguard.db

# Respaldo automático diario en la carpeta respaldos/ (se conservan los últimos 14). 0 = desactivado.
BACKUP_DIR=./respaldos
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# Correo del administrador inicial (se crea en el primer inicio; si lo cambias aquí, se actualiza al reiniciar).
ADMIN_EMAIL=admin@cooperativa.cl

# true = carga datos de ejemplo en una base vacía (para conocer la aplicación). Déjalo en false para uso real.
SEED_DEMO_DATA=false

# Inicio de sesión con código de 6 dígitos enviado por correo.
# Sin servidor de correo, deja AUTH_DEV_LOG_CODES=true: el código aparece en la ventana de la aplicación.
# Úsalo solo si la aplicación corre en tu propio equipo.
AUTH_DEV_LOG_CODES=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RiskGuard Pro <riskguard@cooperativa.cl>

# Duración de la sesión
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=10

# Opcional: clave de Gemini para los análisis con IA (sin ella se usa un resumen calculado).
GEMINI_API_KEY=

# Clave fija para firmar los códigos (opcional; si se deja vacía se genera una al iniciar).
AUTH_SECRET=
