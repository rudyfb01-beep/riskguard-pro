{
  "name": "riskguard-pro",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "cross-env ng serve --port=3000 --host=0.0.0.0 --allowed-hosts=true ${DISABLE_HMR:+--live-reload=false}",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "ng lint",
    "serve:ssr:app": "node --env-file-if-exists=.env dist/app/server/server.mjs",
    "package:sqlite": "ng build && node scripts/empaquetar.mjs",
    "test:api": "node --test --test-concurrency=2 \"tests/api/*.test.mjs\"",
    "test:e2e": "node --test \"tests/e2e/*.test.mjs\"",
    "test:all": "ng test --watch=false && ng build && node --test --test-concurrency=2 \"tests/api/*.test.mjs\" && node --test \"tests/e2e/*.test.mjs\"",
    "audit:prod": "bun audit --prod",
    "demo:build": "node scripts/build-demo.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-server": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@angular/ssr": "^21.0.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@types/pg": "^8.23.1",
    "express": "^5.3.0",
    "material-icons": "^1.13.14",
    "motion": "^12.23.24",
    "nodemailer": "^10.4.0",
    "pg": "^8.23.1",
    "read-excel-file": "^9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "angular-eslint": "21.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "jsdom": "^27.0.0",
    "playwright": "1.63.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.47.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "overrides": {
    "body-parser": "^2.4.0",
    "vite": "^7.3.7",
    "undici": "^7.30.1",
    "@modelcontextprotocol/sdk": "^1.32.0"
  }
}
